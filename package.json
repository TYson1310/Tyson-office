    "@types/react": "19.0.8",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9",
    "eslint-config-next": "^16.2.3",
    "postcss": "^8",
    "playwright": "^1.55.0",
    "prettier": "^3.4.2",
