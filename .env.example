NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

NEXT_PUBLIC_SUPABASE_PAYROLL_BUCKET=payroll-documents
NEXT_PUBLIC_SUPABASE_VENDOR_INVOICE_BUCKET=vendor-invoices
NEXT_PUBLIC_SUPABASE_EXPENSE_DOCUMENT_BUCKET=expense-documents

PRIVATE_ADMIN_LINK_TOKEN=replace-with-random-token
PRIVATE_ADMIN_MASTER_PASSWORD=replace-with-strong-password

GEMINI_API_KEY=your-gemini-api-key
GEMINI_INVOICE_MODEL=gemini-2.5-flash

E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=replace-with-test-password

# Local backup settings. Keep these in .env.local, not in Vercel.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_BACKUP_DIR=backups/supabase
SUPABASE_BACKUP_STORAGE_BUCKETS=payroll-documents,vendor-invoices,expense-documents
# Optional: keep only the newest N timestamped local backups.
# SUPABASE_BACKUP_KEEP=30
